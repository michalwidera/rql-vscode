
#################################################################
## Iro
################################################################ 
##
## * Press Ctrl + '+'/'-' To Zoom in
## * Press Ctrl + S to save and recalculate... 
## * Documents are saved to web storage.
## * Only one save slot supported.
## * Matches cannot span lines.
## * Unicode chars must be defined in \u0000 to \uffff format.
## * All matches must be contained by a single group ( ... )
## * Look behinds not permitted, (?<= or (?<!
## * Look forwards are permitted (?= or (?!
## * Constants are defined as __my_const = (......)
## * The \= format allows unescaped regular expressions
## * Constants referenced by match \= $${__my_const}
## * Constants can reference other constants
## * You are free to delete all the default scopes.
## * Twitter : ainslec , Web: http://eeyo.io/iro
##
################################################################

name                   = rql
file_extensions []     = rql, desc;
textmate_compatible    = true


styles[] {
   .comment_hash  : style color = "#808080" textmate_scope = "comment.line.number-sign";
   .comment_slash : style color = "#808080" textmate_scope = "comment.line.double-slash";
   .comment_block : style color = "#808080" textmate_scope = "comment.block";
   .keyword  : style color = "#FF6666"     textmate_scope = "keyword";
   .operator : style color = "#FF6666"     textmate_scope = "keyword.operator";
   .type     : style color = "#33FFFF"     textmate_scope = "storage.type";
   .desc     : style color = "white"       textmate_scope = "support.function";
   .quoted   : style color = "orange"      textmate_scope = "string.quoted.single";
   .numeric  : style color = "#FF66FF"     textmate_scope = "constant.numeric";
   .deprecated : style color = "#FF6666"   textmate_scope = "invalid.deprecated";
}
contexts[] {

   main : context {
      : include "multi_line_comment" ;
      : include "floatingPoints" ;
      : include "integers" ;
      # DECLARE ... FILE - forma przestarzala (#346). FILE stoi tu zaraz po interwale
      # deklaracji, czego w SELECT ... FILE nie ma. Wiersz kontynuacji `\` nie jest rozpoznawany.
      : pattern {
         regex \= (,\s*[0-9][0-9.]*(?:\s*/\s*[0-9]+)?\s+)((?:FILE|file)\b)
         styles [] = .numeric, .deprecated;
      }
      : pattern {
         regex \= (\b(SELECT|select|STREAM|stream|FROM|from|DECLARE|declare|RETENTION|retention|FILE|file|BINFILE|binfile|TEXTFILE|textfile|DEVICE|device|STORAGE|storage|ROTATION|rotation|SUBSTRAT|substrat|VOLATILE|volatile|PERSISTENT|persistent|RULE|rule|DISPOSABLE|disposable|ONESHOT|oneshot|HOLD|hold|NOCACHE|nocache|CACHE|cache|ON|on|WHEN|when|DO|do|DUMP|dump|SYSTEM|system|TO|to|AND|and|OR|or|NOT|not)\b)
         styles [] = .keyword;
      }
      : pattern {
         regex \= (\b(INTEGER|Integer|BYTE|Byte|CHAR|Char|UINT|Uint|STRING|String|FLOAT|Float|DOUBLE|Double|MEMORY|memory|DEFAULT|default|DIRECT|direct|POSIX|posix|POSIXSHD|posixshd|GENERIC|generic|TEXTSOURCE|textsource)\b)
         styles [] = .type;
      }
      : pattern {
         regex \= (\b(MIN|min|MAX|max|AVG|avg|SUMC|sumc)\b)
         styles [] = .desc;
      }
      : pattern {
         regex \= (\b(?i:sqrt|ceil|floor|abs|round|trunc|sin|cos|exp|tan|log2|log|isnull|null2zero|iszero|isnonzero|length|to_integer|to_float|to_double|to_string|int|float|real|str)\b(?=\s*\())
         styles [] = .desc;
      }
      : pattern {
         regex \= (^\s*#.*)
         styles [] = .comment_hash;
      }
      : pattern {
         regex \= (//.*)
         styles [] = .comment_slash;
      }
      : pattern {
         regex \= ([#&%/>+@^$:])
         styles [] = .operator;
      }
      : inline_push {
         regex \= (\')
         styles [] = .quoted;
         default_style = .quoted
         : pop {
            regex  \= (\')
            styles [] = .quoted;
         }
      }
   }

   multi_line_comment : context {
      description        = multiline
      : inline_push {
         regex          \= (/\*)
         styles []       = .comment_block;
         default_style   = .comment_block
         : pop {
            regex       \= (\*/)
            styles []    = .comment_block;
         }
      }
   }

   floatingPoints : context {
      : pattern {
         regex          \= (\b[0-9][0-9]*)(\.)(\b[0-9][0-9]*)
         styles []       = .numeric;
      }
   }
   
   integers : context {
      : pattern {
         regex          \= (\b[0-9][0-9]*)
         styles []       = .numeric;
      }
   }
}
